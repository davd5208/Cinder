{
    "manifest_version": 3,
    "name": "Cinder",
    "version": "1.1.0",
    "description": "Priatelsky YouTube limit, ktory ti pomoze ukoncit sledovanie v spravny moment.",
    "permissions": [
        "storage"
    ],
    "icons": {
        "16": "logo.svg",
        "32": "logo.svg",
        "48": "logo.svg",
        "128": "logo.svg"
    },
    "action": {
        "default_icon": {
            "16": "logo.svg",
            "32": "logo.svg",
            "48": "logo.svg",
            "128": "logo.svg"
        },
        "default_popup": "popup.html",
        "default_title": "Cinder"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}
